---
import { bookingHref } from '../data/site';
import { homePath, otherLang, pick, type Lang } from '../i18n/lang';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const other = otherLang(lang);
const home = homePath(lang);
---

<header class="nav">
  <a class="nav-name" href={home}><span>Studio</span> <span>Faber</span></a>
  <div class="nav-end">
    <nav class="nav-links" aria-label={pick(ui.nav.label, lang)}>
      <a href={`${home}#work`}>{pick(ui.nav.work, lang)}</a>
      <a href={`${home}#contact`}>{pick(ui.nav.contact, lang)}</a>
    </nav>
    <a class="nav-lang" href={alternate} hreflang={other} lang={other} data-lang={other}>
      {pick(ui.nav.otherShort, lang)}<span class="sr-only">, {pick(ui.nav.other, lang)}</span>
    </a>
    <button class="nav-theme" type="button" aria-label={pick(ui.nav.toLight, lang)} data-to-light={pick(ui.nav.toLight, lang)} data-to-dark={pick(ui.nav.toDark, lang)}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <circle cx="9" cy="9" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M9 1.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
      </svg>
    </button>
    <a class="btn btn-primary" href={bookingHref(pick(ui.bookSubject, lang))}>{pick(ui.book, lang)}</a>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.nav-theme')!;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const light = root.dataset.theme === 'light';
    button.setAttribute('aria-label', (light ? button.dataset.toDark : button.dataset.toLight) ?? '');
    meta?.setAttribute('content', light ? '#ece8df' : '#07090c');
  };
  sync();
  button.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem('hs-theme', root.dataset.theme);
    } catch {
      /* the choice lasts for this page only */
    }
    sync();
  });
  // Bare over the hero, a glass band once the page moves under it.
  const nav = document.querySelector<HTMLElement>('.nav')!;
  const band = () => nav.classList.toggle('scrolled', scrollY > 8);
  band();
  addEventListener('scroll', band, { passive: true });
  document.querySelector<HTMLAnchorElement>('.nav-lang')?.addEventListener('click', (e) => {
    try {
      localStorage.setItem('hs-lang', (e.currentTarget as HTMLAnchorElement).dataset.lang ?? '');
    } catch {
      /* fine */
    }
  });
</script>

<style>
  /* The name in one corner, the way in the other. */
  .nav {
    position: fixed;
    z-index: 40;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: calc(env(safe-area-inset-top, 0px) + 24px) max(var(--pad), env(safe-area-inset-right, 0px)) 24px max(var(--pad), env(safe-area-inset-left, 0px));
    font-size: 0.9375rem;
    transition: padding 0.35s var(--ease-out), background-color 0.35s ease, box-shadow 0.35s ease;
    view-transition-name: nav;
  }

  .nav.scrolled {
    padding-top: calc(env(safe-area-inset-top, 0px) + 16px);
    padding-bottom: 16px;
    background: var(--glass);
    box-shadow: 0 1px 0 var(--line);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
  }

  /* A case study opens on its project's deep colour in both themes: the bare nav takes that colour's ink. */
  :global(body:has(.case-hero)) .nav:not(.scrolled) {
    --fg: var(--on-tone);
    --mist: var(--on-tone-mist);
    --em: #34b98a;
    --cta: #ece6da;
    --cta-hi: #ffffff;
    --cta-ink: #0b0d10;
    color: var(--fg);
  }

  .nav-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--display);
    font-weight: 300;
    font-size: 1.4375rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-end {
    flex: none;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links {
    display: flex;
    gap: 32px;
  }

  .nav-links a,
  .nav-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    color: var(--mist);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-lang:hover {
    color: var(--fg);
  }

  .nav-theme {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 44px;
    margin: 0 -12px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--mist);
    cursor: pointer;
  }

  .nav-theme:hover {
    color: var(--fg);
  }

  .btn {
    min-height: 44px;
    padding: 0 22px;
    font-size: 0.875rem;
  }

  @media (max-width: 40rem) {
    .nav {
      gap: 12px;
      padding-top: calc(env(safe-area-inset-top, 0px) + 14px);
      padding-bottom: 14px;
    }

    .nav.scrolled {
      padding-top: calc(env(safe-area-inset-top, 0px) + 10px);
      padding-bottom: 10px;
    }

    /* Stacked, the name leaves room for the longer French button. */
    .nav-name {
      font-size: 1.1875rem;
      line-height: 1.02;
    }

    .nav-name span {
      display: block;
    }

    .nav-end {
      gap: 8px;
    }

    .nav-links {
      display: none;
    }

    .nav-lang {
      min-width: 28px;
      font-size: 0.875rem;
    }

    .nav-theme {
      margin: 0;
    }

    .btn {
      padding: 0 16px;
    }
  }

  @media (max-width: 23rem) {
    .nav-name {
      font-size: 1.0625rem;
    }

    .nav-end {
      gap: 4px;
    }

    .btn {
      padding: 0 14px;
    }
  }
</style>
