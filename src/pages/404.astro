---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
---

<Base lang="fr" title="Page introuvable | Studio Faber" alternate="/en/" noindex>
  <section class="lost wrap">
    <div lang="fr">
      <h1>{ui.notFound.title.fr}</h1>
      <p>{ui.notFound.body.fr}</p>
      <a class="btn btn-primary" href="/">{ui.notFound.home.fr}</a>
    </div>
    <div lang="en">
      <h2>{ui.notFound.title.en}</h2>
      <p>{ui.notFound.body.en}</p>
      <a class="btn btn-ghost" href="/en/">{ui.notFound.home.en}</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 8vh clamp(24px, 5vw, 80px);
    align-content: center;
    min-height: 90svh;
    padding-top: var(--nav-h);
  }

  .lost div {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  h1,
  h2 {
    font-family: var(--display);
    font-weight: 100;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 1.04;
  }

  p {
    color: var(--mist);
  }
</style>
